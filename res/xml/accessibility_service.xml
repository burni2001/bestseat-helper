<?xml version="1.0" encoding="utf-8"?>
<!-- Declare all capabilities here; they can't be added at runtime.
     Hub sets event types, packages and the key filter for the active helpers
     via setServiceInfo(). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="tv.bestseat.helper"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="40"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/service_description" />
